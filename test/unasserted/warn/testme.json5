{
    /*
        Fixtures for ../../unasserted.tst.ts, run under the default unasserted policy. One asserts
        nothing on purpose, so they must never be collected by an ordinary run -- "manual" means
        they run only when explicitly named. Serial, so the summary depends only on the fixtures.
     */
    enable: 'manual',

    execution: {
        parallel: false,
    },
}
